            "body": {
              "mode": "raw",
              "raw": "{\n  \"razonSocial\": \"Cliente API {{documento}}\",\n  \"saldoDeudor\": 0,\n  \"limiteCredito\": 10000,\n  \"estado\": \"Activo\",\n  \"personaDeContacto\": \"Sofía Demo\",\n  \"condicionDePago\": \"Cuenta corriente\",\n  \"persona\": {\n    \"nombre\": \"Sofía\",\n    \"apellido\": \"Demo\",\n    \"numeroDocumento\": \"{{documento}}\",\n    \"telefono\": \"3424000099\",\n    \"email\": \"sofia.{{documento}}@gestapro.test\",\n    \"tipoDocumento\": {\n      \"idTipoDocumento\": 1\n    },\n    \"tipoPersona\": {\n      \"idTipoPersona\": 1\n    },\n    \"direccion\": {\n      \"calle\": \"Bv. Pellegrini\",\n      \"numero\": \"2350\",\n      \"codigoPostal\": \"3000\",\n      \"ciudad\": \"Santa Fe\",\n      \"provincia\": \"Santa Fe\",\n      \"pais\": \"Argentina\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
